---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaMitglied from "../components/CtaMitglied.astro";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
---

<BaseLayout title={copy.faq.title} description={copy.faq.desc}>
  <div class="stack">
    <h1>{copy.faq.h1}</h1>

    <div class="faq-list">
      <details class="faq-item" name="faq">
        <summary>{copy.faq.q1}</summary>
        <p>{copy.faq.a1}</p>
      </details>
      <details class="faq-item" name="faq">
        <summary>{copy.faq.q2}</summary>
        <p>{copy.faq.a2}</p>
      </details>
      <details class="faq-item" name="faq">
        <summary>{copy.faq.q3}</summary>
        <p>
          <a href={href("/vor-ort")}>{copy.faq.q3Link}</a>. {copy.faq.a3}
        </p>
      </details>
      <details class="faq-item" name="faq">
        <summary>{copy.faq.q4}</summary>
        <p>
          {copy.faq.a4}
          {" "}
          <a href={href("/vor-ort")}>{copy.faq.a4Link}</a>.
        </p>
      </details>
      <details class="faq-item" name="faq">
        <summary>{copy.faq.q5}</summary>
        <p>{copy.faq.a5}</p>
      </details>
      <details class="faq-item" name="faq">
        <summary>{copy.faq.q6}</summary>
        <p>{copy.faq.a6}</p>
      </details>
      <details class="faq-item" name="faq">
        <summary>{copy.faq.q7}</summary>
        <p>{copy.faq.a7}</p>
      </details>
    </div>

    <CtaMitglied />
  </div>
</BaseLayout>
