---
import BaseLayout from "../layouts/BaseLayout.astro";
import CourseCard from "../components/CourseCard.astro";
import LetterVortex from "../components/LetterVortex.astro";
import QuoteBand from "../components/QuoteBand.astro";
import { locPath, pageLocale } from "../lib/i18n";
import { ANMELDUNG_HASH, TRAEGER_HASH } from "../lib/course";
import { EXT, PARTNERS } from "../lib/links";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
const anmelden = `${href("/so-gehts")}${ANMELDUNG_HASH}`;
const traeger = `${href("/vor-ort")}${TRAEGER_HASH}`;
const preise = href("/preise");

const plannedCities = copy.home.firstCities.filter((city) => !city.start);
const plannedPreview = 4;
---

<BaseLayout full title={copy.home.title} description={copy.home.description}>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1 set:html={copy.home.h1} />
      <p>{copy.home.lead}</p>
      <div class="hero-actions">
        <a class="btn" href={anmelden}>{copy.home.registerNow}</a>
        <a class="btn-text" href="#naechste-kurse">{copy.home.viewCourses}</a>
      </div>
    </div>
    <LetterVortex />
  </section>

  <QuoteBand />

  <section class="wrap next-course" id="naechste-kurse" aria-labelledby="next-courses-heading">
    <h2 id="next-courses-heading" class="next-course-eyebrow">{copy.home.nextEyebrow}</h2>
    <div class="course-chip-list">
      {
        copy.home.nextCourses.map((course, index) => (
          <CourseCard
            status={course.status}
            level={course.level}
            place={course.place}
            venue={course.venue}
            start={course.start}
            schedule={course.schedule}
            format={course.format}
            detailsHref={preise}
            detailsLabel={copy.home.courseDetails}
            ctaHref={anmelden}
            ctaLabel={copy.home.registerNow}
            panelId={`course-panel-${index}`}
          />
        ))
      }
    </div>
  </section>

  <section class="wrap why-section" aria-labelledby="why-heading">
    <h2 id="why-heading">{copy.home.whyTitle}</h2>
    <ul class="why-list">
      {
        copy.home.whyItems.map((item) => (
          <li class="why-item">
            <h3 class="why-item-title">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap price-snapshot" aria-labelledby="price-heading">
    <h2 id="price-heading">{copy.home.priceTitle}</h2>
    <div class="price-snapshot-grid">
      <div class="price-option price-option-preferred">
        <p class="price-option-label">{copy.home.priceMemberLabel}</p>
        <p class="price-option-amount">{copy.home.priceMemberAmount}</p>
        <p class="price-option-meta">{copy.home.priceMemberMeta}</p>
      </div>
      <div class="price-option">
        <p class="price-option-label">{copy.home.priceNonLabel}</p>
        <p class="price-option-amount">{copy.home.priceNonAmount}</p>
        <p class="price-option-meta">{copy.home.priceNonMeta}</p>
      </div>
    </div>
    <p class="price-snapshot-note muted">{copy.home.priceNote}</p>
    <p class="price-snapshot-actions">
      <a class="btn-text" href={preise}>{copy.home.priceLink}</a>
    </p>
  </section>

  <section class="wrap trust-section" aria-labelledby="trust-heading">
    <h2 id="trust-heading" class="trust-heading">{copy.home.trustTitle}</h2>
    <p class="trust-method muted">{copy.home.trustMethod}</p>
    <div class="partner-bar trust-bar">
      {
        PARTNERS.map((partner) => (
          <a
            href={partner.href}
            {...EXT}
            aria-label={copy.partner.names[partner.id] ?? partner.name}
            data-partner={partner.id}
          >
            <img
              src={partner.logo}
              alt=""
              width={partner.width}
              height={partner.height}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
    <p class="trust-link">
      <a href={href("/partner")}>{copy.home.trustLink}</a>
    </p>
  </section>

  <section class="wrap first-ulpan" aria-labelledby="first-ulpan-heading">
    <h2 id="first-ulpan-heading">{copy.home.firstH2}</h2>
    <p>{copy.home.firstText}</p>

    <div class="city-block" data-city-planned>
      <h3 class="city-block-title">{copy.home.plannedCitiesTitle}</h3>
      <ul class="city-chips">
        {
          plannedCities.map((city, index) => (
            <li
              class:list={[
                "city-chip",
                { "city-chip-extra": index >= plannedPreview },
              ]}
            >
              <span class="city-chip-name">{city.name}</span>
              <span class="city-chip-badge">{copy.home.firstPlannedBadge}</span>
            </li>
          ))
        }
      </ul>
      {
        plannedCities.length > plannedPreview && (
          <button
            type="button"
            class="btn-text city-toggle"
            data-city-toggle
            data-label-more={copy.home.showMoreCities}
            data-label-less={copy.home.hideCities}
            aria-expanded="false"
          >
            {copy.home.showMoreCities}
          </button>
        )
      }
    </div>

    <div class="first-ulpan-actions">
      <div class="first-ulpan-action">
        <a class="btn btn-ghost" href={anmelden}>{copy.home.firstWaitlistCta}</a>
        <p class="muted">{copy.home.firstWaitlistNote}</p>
      </div>
      <div class="first-ulpan-action">
        <a class="btn btn-ghost" href={traeger}>{copy.home.firstGroupCta}</a>
        <p class="muted">{copy.home.firstGroupNote}</p>
      </div>
    </div>
    <aside class="group-callout" aria-labelledby="group-callout-title">
      <div class="group-callout-body">
        <p class="group-callout-title" id="group-callout-title">{copy.home.firstBoxTitle}</p>
        <p>{copy.home.firstBoxText}</p>
      </div>
    </aside>
  </section>

  <section class="wrap home-close">
    <p class="cta-pitch">{copy.home.ctaPitch}</p>
    <div class="hero-actions">
      <a class="btn" href={anmelden}>{copy.home.registerNow}</a>
    </div>
    <p class="cta-ask muted">
      {copy.home.ctaQuestions}
      {" "}
      <a href={href("/kontakt")}>{copy.home.ctaContact}</a>
    </p>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-course-chip]").forEach((chip) => {
    const trigger = chip.querySelector<HTMLButtonElement>(".course-chip-summary");
    const panel = chip.querySelector<HTMLElement>(".course-chip-body");
    if (!trigger || !panel) return;

    trigger.addEventListener("click", () => {
      const open = trigger.getAttribute("aria-expanded") === "true";
      const next = !open;
      trigger.setAttribute("aria-expanded", String(next));
      panel.hidden = !next;
      chip.classList.toggle("is-open", next);
    });

    if (trigger.getAttribute("aria-expanded") === "true") {
      chip.classList.add("is-open");
      panel.hidden = false;
    }
  });

  const block = document.querySelector<HTMLElement>("[data-city-planned]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-city-toggle]");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    const next = !expanded;
    toggle.setAttribute("aria-expanded", String(next));
    toggle.textContent = next
      ? toggle.dataset.labelLess ?? ""
      : toggle.dataset.labelMore ?? "";
    block?.classList.toggle("is-expanded", next);
  });
</script>
