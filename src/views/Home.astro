---
import BaseLayout from "../layouts/BaseLayout.astro";
import CourseCard from "../components/CourseCard.astro";
import LetterVortex from "../components/LetterVortex.astro";
import QuoteBand from "../components/QuoteBand.astro";
import { locPath, pageLocale } from "../lib/i18n";
import { ANMELDUNG_HASH, TRAEGER_HASH } from "../lib/course";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
const anmelden = `${href("/so-gehts")}${ANMELDUNG_HASH}`;
const traeger = `${href("/vor-ort")}${TRAEGER_HASH}`;
const preise = href("/preise");

const activeCities = copy.home.firstCities.filter((city) => Boolean(city.start));
const plannedCities = copy.home.firstCities.filter((city) => !city.start);
const plannedPreview = 6;
---

<BaseLayout full title={copy.home.title} description={copy.home.description}>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1 set:html={copy.home.h1} />
      <p>{copy.home.lead}</p>
      <div class="hero-actions">
        <a class="btn" href={anmelden}>{copy.home.registerNow}</a>
      </div>
    </div>
    <LetterVortex />
  </section>

  <QuoteBand />

  <section class="wrap next-course" aria-label={copy.home.nextEyebrow}>
    <p class="next-course-eyebrow home-perk">{copy.home.nextEyebrow}</p>
    <div class="next-course-grid">
      {
        copy.home.nextCourses.map((course) => (
          <CourseCard
            status={course.status}
            level={course.level}
            place={course.place}
            venue={course.venue}
            start={course.start}
            schedule={course.schedule}
            format={course.format}
            detailsHref={preise}
            detailsLabel={copy.home.courseDetails}
            ctaHref={anmelden}
            ctaLabel={copy.home.registerNow}
          />
        ))
      }
    </div>
  </section>

  <section class="wrap first-ulpan" aria-labelledby="first-ulpan-heading">
    <h2 id="first-ulpan-heading">{copy.home.firstH2}</h2>
    <p>{copy.home.firstText}</p>

    <div class="city-block">
      <h3 class="city-block-title">{copy.home.activeCitiesTitle}</h3>
      <ul class="city-chips">
        {
          activeCities.map((city) => (
            <li class="city-chip city-chip-active">
              <span class="city-chip-name">{city.name}</span>
              <span class="city-chip-badge">{city.start}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="city-block" data-city-planned>
      <h3 class="city-block-title">{copy.home.plannedCitiesTitle}</h3>
      <ul class="city-chips">
        {
          plannedCities.map((city, index) => (
            <li
              class:list={[
                "city-chip",
                { "city-chip-extra": index >= plannedPreview },
              ]}
            >
              <span class="city-chip-name">{city.name}</span>
              <span class="city-chip-badge">{copy.home.firstPlannedBadge}</span>
            </li>
          ))
        }
      </ul>
      {
        plannedCities.length > plannedPreview && (
          <button
            type="button"
            class="btn-text city-toggle"
            data-city-toggle
            data-label-more={copy.home.showMoreCities}
            data-label-less={copy.home.hideCities}
            aria-expanded="false"
          >
            {copy.home.showMoreCities}
          </button>
        )
      }
      <p class="city-planned-cta">
        <a class="btn btn-ghost" href={anmelden}>{copy.home.cityRegisterCta}</a>
      </p>
    </div>

    <div class="first-ulpan-actions">
      <div class="first-ulpan-action">
        <a class="btn" href={anmelden}>{copy.home.firstWaitlistCta}</a>
        <p class="muted">{copy.home.firstWaitlistNote}</p>
      </div>
      <div class="first-ulpan-action">
        <a class="btn btn-ghost" href={traeger}>{copy.home.firstGroupCta}</a>
        <p class="muted">{copy.home.firstGroupNote}</p>
      </div>
    </div>
    <aside class="group-callout">
      <div class="group-callout-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75">
          <circle cx="9" cy="8" r="3.25"></circle>
          <circle cx="16.5" cy="9.5" r="2.5"></circle>
          <path d="M3.5 18.5c.6-3.2 2.9-5 5.5-5s4.9 1.8 5.5 5"></path>
          <path d="M13.2 16.2c.9-1.7 2.5-2.7 4.3-2.7 1.7 0 3.1.8 4 2.3"></path>
        </svg>
      </div>
      <div class="group-callout-body">
        <p class="group-callout-title">{copy.home.firstBoxTitle}</p>
        <p>{copy.home.firstBoxText}</p>
        <p><a class="btn btn-ghost" href={href("/kontakt")}>{copy.home.firstBoxCta}</a></p>
      </div>
    </aside>
  </section>

  <section class="wrap join-band">
    <ul class="feature-list">
      <li>{copy.home.f1}</li>
      <li>{copy.home.f3}</li>
    </ul>
    <div class="cta-frame">
      <a class="btn" href={anmelden}>{copy.home.registerNow}</a>
      <p class="cta-pitch">{copy.home.ctaPitch}</p>
      <p class="cta-ask">
        {copy.home.ctaQuestions}
        {" "}
        <a href={href("/kontakt")}>{copy.home.ctaContact}</a>
      </p>
    </div>
  </section>

  <section class="wrap stack home-cards">
    <div class="card-list">
      <article class="card card-local">
        <h2>{copy.home.localTitle}</h2>
        <p>{copy.home.localText}</p>
        <p><a href={anmelden}>{copy.home.localLink}</a></p>
      </article>
      <article class="card card-online">
        <p class="badge-soon">{copy.home.onlineBadge}</p>
        <h2>{copy.home.onlineTitle}</h2>
        <p>{copy.home.onlineText}</p>
        <p><a class="btn btn-ghost" href={href("/kontakt")}>{copy.home.onlineCta}</a></p>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  const block = document.querySelector<HTMLElement>("[data-city-planned]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-city-toggle]");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    const next = !expanded;
    toggle.setAttribute("aria-expanded", String(next));
    toggle.textContent = next
      ? toggle.dataset.labelLess ?? ""
      : toggle.dataset.labelMore ?? "";
    block?.classList.toggle("is-expanded", next);
  });
</script>
