---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ANMELDUNG_HASH } from "../lib/course";
import { LINKS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
const anmelden = `${href("/so-gehts")}${ANMELDUNG_HASH}`;
---

<BaseLayout title={copy.kontakt.title} description={copy.kontakt.desc}>
  <div class="stack">
    <h1>{copy.kontakt.h1}</h1>
    <p>
      {copy.kontakt.intro}
      {" "}
      <a href={`mailto:${LINKS.contactEmail}`}>{LINKS.contactEmail}</a>.
    </p>
    <p>
      <a class="btn" href={`mailto:${LINKS.contactEmail}`}>{copy.kontakt.mail}</a>
    </p>

    <div class="card-list card-list-3">
      <article class="card">
        <h2>{copy.kontakt.learnersTitle}</h2>
        <p>{copy.kontakt.learners}</p>
        <p><a class="btn" href={anmelden}>{copy.kontakt.learnersLink}</a></p>
      </article>
      <article class="card">
        <h2>{copy.kontakt.orgsTitle}</h2>
        <p>{copy.kontakt.orgs}</p>
        <p><a class="btn btn-ghost" href={href("/vor-ort")}>{copy.kontakt.orgsLink}</a></p>
      </article>
      <article class="card">
        <h2>{copy.kontakt.teachersTitle}</h2>
        <p>{copy.kontakt.teachers}</p>
        <p><a class="btn btn-ghost" href={href("/stellen")}>{copy.kontakt.teachersLink}</a></p>
      </article>
    </div>
  </div>
</BaseLayout>
