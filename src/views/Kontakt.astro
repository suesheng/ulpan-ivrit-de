---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LINKS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
---

<BaseLayout title={copy.kontakt.title}>
  <div class="stack">
    <h1>{copy.kontakt.h1}</h1>
    <p>
      {copy.kontakt.general}
      {" "}
      <a href={`mailto:${LINKS.contactEmail}`}>{LINKS.contactEmail}</a>.
    </p>
    <p>
      {copy.kontakt.orgs}
      {" "}
      <a href={href("/vor-ort")}>{copy.kontakt.orgsLink}</a>.
    </p>
    <p>
      {copy.kontakt.teachers}
      {" "}
      <a href={href("/stellen")}>{copy.kontakt.teachersLink}</a>.
    </p>
    <p>
      {copy.kontakt.learners}
      {" "}
      <a href={href("/so-gehts")}>{copy.kontakt.learnersLink}</a>.
    </p>
  </div>
</BaseLayout>
