---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaMitglied from "../components/CtaMitglied.astro";
import PrivacyCheck from "../components/PrivacyCheck.astro";
import { LINKS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
const subject = encodeURIComponent(copy.soGehts.subject);
---

<BaseLayout title={copy.soGehts.title} description={copy.soGehts.desc}>
  <div class="stack">
    <h1>{copy.soGehts.h1}</h1>
    <p>{copy.soGehts.intro}</p>

    <ol class="path">
      <li class="path-step">
        <h2>{copy.soGehts.step1}</h2>
        <div class="path-body">
          <p>{copy.soGehts.step1Text}</p>
          <p><strong>{copy.soGehts.step1BenefitsTitle}</strong></p>
          <ul class="feature-list">
            {copy.soGehts.step1Benefits.map((item) => <li>{item}</li>)}
          </ul>
          <p>{copy.soGehts.step1Fee}</p>
          <CtaMitglied />
        </div>
      </li>

      <li class="path-step">
        <h2>{copy.soGehts.step2}</h2>
        <div class="path-body">
          <div class="card-list">
            <article class="card card-online">
              <h3>{copy.soGehts.onlineTitle}</h3>
              <p>{copy.soGehts.onlineText}</p>
              <p><a href={href("/kurse")}>{copy.soGehts.onlineLink}</a></p>
            </article>
            <article class="card card-local">
              <h3>{copy.soGehts.localTitle}</h3>
              <p>{copy.soGehts.localText}</p>
              <p>
                <strong>{copy.soGehts.citiesTitle}</strong>
                {" "}
                {copy.soGehts.cities.join(", ")}
              </p>
              <p><a href="#gemeinde">{copy.soGehts.localMail}</a></p>
            </article>
          </div>
        </div>
      </li>

      <li class="path-step" id="gemeinde">
        <h2>{copy.soGehts.step3}</h2>
        <div class="path-body">
          <p>{copy.soGehts.wishText}</p>
          <p>{copy.soGehts.formLead}</p>
          <p class="muted">
            {copy.soGehts.formMail}
            {" "}
            <a href={`mailto:${LINKS.contactEmail}`}>{LINKS.contactEmail}</a>.
          </p>

          <form
            class="stack path-form"
            method="post"
            enctype="text/plain"
            action={`mailto:${LINKS.contactEmail}?subject=${subject}`}
            data-inquiry="location"
            data-sent={copy.form.sent}
            data-error={copy.form.error}
            data-sending={copy.form.sending}
          >
            <input type="hidden" name="locale" value={locale} />
            <div class="hp" aria-hidden="true">
              <label>
                Website
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <label>
              {copy.soGehts.name}
              <input type="text" name="Name" autocomplete="name" required />
            </label>
            <label>
              {copy.soGehts.email}
              <input
                type="email"
                name="E-Mail"
                autocomplete="email"
                spellcheck="false"
                required
              />
            </label>
            <label>
              {copy.soGehts.org}
              <input
                type="text"
                name="Gemeinde_Organisation"
                autocomplete="organization"
                placeholder={copy.soGehts.orgPh}
              />
            </label>
            <label>
              {copy.soGehts.city}
              <input
                type="text"
                name="Ort"
                autocomplete="address-level2"
                required
                placeholder={copy.soGehts.cityPh}
              />
            </label>
            <label>
              {copy.soGehts.message}
              <textarea
                name="Nachricht"
                autocomplete="off"
                required
                placeholder={copy.soGehts.messagePh}
              ></textarea>
            </label>
            <PrivacyCheck />
            <button type="submit">{copy.soGehts.submit}</button>
            <p class="form-status" data-form-status hidden></p>
          </form>

          <p class="muted">
            {copy.soGehts.step3Text}
            {" "}
            <a href={href("/vor-ort")}>{copy.soGehts.step3Link}</a>.
          </p>
        </div>
      </li>
    </ol>
  </div>
</BaseLayout>
