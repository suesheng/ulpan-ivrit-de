---
import BaseLayout from "../layouts/BaseLayout.astro";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
const anmelden = `${href("/so-gehts")}#anmelden`;
const formSrc = "/api/jotform-ulpan";
---

<BaseLayout title={copy.soGehts.title} description={copy.soGehts.desc}>
  <div class="stack">
    <h1>{copy.soGehts.h1}</h1>
    <p>{copy.soGehts.intro}</p>

    <ol class="path">
      <li class="path-step">
        <h2>{copy.soGehts.step1}</h2>
        <div class="path-body">
          <p>{copy.soGehts.step1Text}</p>
          <p><strong>{copy.soGehts.step1BenefitsTitle}</strong></p>
          <ul class="feature-list">
            {copy.soGehts.step1Benefits.map((item) => <li>{item}</li>)}
          </ul>
          <p>{copy.soGehts.step1Fee}</p>
          <a class="btn" href={anmelden}>{copy.soGehts.step1Cta}</a>
        </div>
      </li>

      <li class="path-step">
        <h2>{copy.soGehts.step2}</h2>
        <div class="path-body">
          <p>{copy.soGehts.step2Text}</p>
          <div class="card-list">
            <article class="card card-online">
              <h3>{copy.soGehts.formatTitle}</h3>
              <p>{copy.soGehts.formatText}</p>
            </article>
            <article class="card card-local">
              <h3>{copy.soGehts.locationsTitle}</h3>
              <p>{copy.soGehts.locationsText}</p>
              <p>
                <strong>{copy.soGehts.citiesTitle}</strong>
                {" "}
                {copy.soGehts.cities.join(", ")}
              </p>
            </article>
          </div>
          <p>{copy.soGehts.step2Fee}</p>
          <a class="btn" href={anmelden}>{copy.soGehts.step2Cta}</a>
        </div>
      </li>

      <li class="path-step">
        <h2>{copy.soGehts.step3}</h2>
        <div class="path-body">
          <p>{copy.soGehts.step3Intro}</p>
          <ul class="feature-list">
            {copy.soGehts.step3Items.map((item) => <li>{item}</li>)}
          </ul>
          <p><strong>{copy.soGehts.paymentTitle}</strong></p>
          <ul class="feature-list">
            {copy.soGehts.paymentItems.map((item) => <li>{item}</li>)}
          </ul>
          <p>{copy.soGehts.step3Note}</p>
        </div>
      </li>
    </ol>

    <section id="anmelden" class="stack jotform-embed" aria-label={copy.soGehts.formTitle}>
      <h2>{copy.soGehts.formTitle}</h2>
      <div class="jotform-frame">
        <iframe
          id="JotFormIFrame-261742322871052"
          title={copy.soGehts.formTitle}
          allow="geolocation; microphone; camera; fullscreen; payment"
          src={formSrc}
          loading="eager"
          scrolling="no"
        ></iframe>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var iframe = document.getElementById("JotFormIFrame-261742322871052");
    if (!iframe) return;

    var lastHeight = 0;
    var settleTimer = null;

    function isThankYou(doc) {
      if (!doc || !doc.body) return false;
      var text = (doc.body.innerText || "").slice(0, 2000).toLowerCase();
      if (text.indexOf("vielen dank") !== -1 || text.indexOf("thank you") !== -1) return true;
      if (doc.querySelector("[class*='thankyou'], [class*='ThankYou'], .thankyou-wrapper")) return true;
      return false;
    }

    /** Measure real form content — never document.scrollHeight (iframe feedback loop). */
    function measureContentHeight(doc) {
      if (!doc || !doc.body) return 0;
      var thankyou = isThankYou(doc);

      if (thankyou) {
        var ty =
          doc.querySelector("[class*='thankyou'], [class*='ThankYou'], .thankyou-wrapper, .ty-container") ||
          doc.querySelector(".form-all") ||
          doc.body;
        var tyRect = ty.getBoundingClientRect();
        return Math.ceil((tyRect.height || ty.offsetHeight || 0) + 32);
      }

      // Active page only — never sum all pagebreak sections.
      var sections = doc.querySelectorAll(".form-section");
      var active = null;
      for (var s = 0; s < sections.length; s++) {
        var sec = sections[s];
        var st = doc.defaultView && doc.defaultView.getComputedStyle(sec);
        if (!st || st.display === "none" || st.visibility === "hidden") continue;
        if (sec.offsetHeight < 2) continue;
        active = sec;
        break;
      }

      var target =
        active ||
        doc.querySelector(".form-all") ||
        doc.querySelector("form.jotform-form") ||
        doc.querySelector("form");
      if (!target) return 0;

      var lines = target.querySelectorAll(
        ".form-line, .form-pagebreak, .form-buttons-wrapper, .form-submit-clear-wrapper",
      );
      var top = Infinity;
      var bottom = 0;
      var found = false;
      for (var i = 0; i < lines.length; i++) {
        var n = lines[i];
        var style = doc.defaultView && doc.defaultView.getComputedStyle(n);
        if (style && (style.display === "none" || style.visibility === "hidden")) continue;
        var r = n.getBoundingClientRect();
        if (r.height < 1) continue;
        found = true;
        top = Math.min(top, r.top);
        bottom = Math.max(bottom, r.bottom);
      }
      if (found && isFinite(top)) {
        // Extra buffer so the pagebreak button never clips / forces a scrollbar.
        return Math.ceil(bottom - top + 96);
      }
      // Fallback: offsetHeight of active section only (not body/html).
      return Math.ceil((target.offsetHeight || 0) + 72);
    }

    function setHeight(h, thankyou) {
      var height = Number(h) || 0;
      if (!height || height < 100) return;
      if (thankyou) {
        height = Math.max(240, Math.min(height, 560));
        iframe.classList.add("is-thankyou");
      } else {
        height = Math.max(520, Math.min(height, 2400));
        iframe.classList.remove("is-thankyou");
      }
      height = Math.ceil(height);
      if (Math.abs(height - lastHeight) < 8) return;
      lastHeight = height;
      iframe.style.height = height + "px";
      iframe.setAttribute("scrolling", "no");
    }

    function syncSameOrigin() {
      try {
        var doc = iframe.contentDocument;
        if (!doc || !doc.body) return;
        var thankyou = isThankYou(doc);
        if (thankyou) {
          doc.documentElement.classList.add("thankyou");
          doc.body.classList.add("thankyou");
        }
        var h = measureContentHeight(doc);
        if (h > 80) setHeight(h, thankyou);
      } catch (_) {
        /* ignore */
      }
    }

    function scheduleSync() {
      if (settleTimer) clearTimeout(settleTimer);
      settleTimer = setTimeout(syncSameOrigin, 120);
    }

    window.addEventListener("message", function (e) {
      if (!e || e.source !== iframe.contentWindow || !e.data) return;
      var origin = String(e.origin || "");
      var ok =
        origin === window.location.origin ||
        origin.indexOf("jotform.com") !== -1 ||
        origin.indexOf("jotfor.ms") !== -1;
      if (!ok) return;

      var data = e.data;
      var thankyou = false;
      try {
        thankyou = isThankYou(iframe.contentDocument) || !!(data && data.thankYou);
      } catch (_) {}

      if (typeof data === "object") {
        if (data.thankYou || data.action === "submission-completed" || data.action === "thankYou") {
          setHeight(data.height || 320, true);
          scheduleSync();
          return;
        }
        // Ignore raw setHeight from Jotform if it looks like viewport feedback
        if (data.action === "setHeight" || data.action === "setPageHeight") {
          var incoming = Number(data.height || data.value) || 0;
          if (thankyou) {
            setHeight(incoming, true);
          } else if (incoming > 0 && incoming < 2400) {
            // Prefer our own measure; only accept if close to content
            scheduleSync();
          }
          return;
        }
      }
      scheduleSync();
    });

    iframe.addEventListener("load", function () {
      lastHeight = 0;
      syncSameOrigin();
      setTimeout(syncSameOrigin, 300);
      setTimeout(syncSameOrigin, 900);
      try {
        var doc = iframe.contentDocument;
        if (!doc) return;
        var mo = new MutationObserver(scheduleSync);
        mo.observe(doc.documentElement, { childList: true, subtree: true });
      } catch (_) {
        /* ignore */
      }
    });
  })();
</script>
