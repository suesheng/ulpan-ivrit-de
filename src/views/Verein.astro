---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaMitglied from "../components/CtaMitglied.astro";
import { EXT, LINKS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
---

<BaseLayout title={copy.verein.title} description={copy.verein.desc}>
  <div class="stack">
    <h1>{copy.verein.h1}</h1>
    <p>{copy.verein.p1}</p>
    <ul class="feature-list">
      <li>{copy.verein.fees}</li>
      <li>{copy.verein.talks}</li>
    </ul>
    <CtaMitglied />
    <p class="actions">
      <a href={locPath(locale, "/partner")}>{copy.verein.partner}</a>
      <a href={LINKS.ulpanProject} {...EXT}>{copy.verein.project}</a>
      <a href={LINKS.vereinHome} {...EXT}>bifode.org</a>
    </p>
  </div>
</BaseLayout>
