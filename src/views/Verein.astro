---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaMitglied from "../components/CtaMitglied.astro";
import { LINKS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
---

<BaseLayout title={copy.verein.title}>
  <div class="stack">
    <h1>{copy.verein.h1}</h1>
    <p>{copy.verein.p1}</p>
    <p>{copy.verein.fees}</p>
    <p>
      <a href={locPath(locale, "/partner")}>{copy.verein.partner}</a> ·
      <a href={LINKS.ulpanProject}>{copy.verein.project}</a> ·
      <a href={LINKS.vereinHome}>bifode.org</a>
    </p>
    <CtaMitglied />
  </div>
</BaseLayout>
