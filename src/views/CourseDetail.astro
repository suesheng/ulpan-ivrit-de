---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ANMELDUNG_HASH } from "../lib/course";
import { EXT, LINKS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";
import type { CollectionEntry } from "astro:content";

interface Props {
  course: CollectionEntry<"courses">;
}

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const { course } = Astro.props;
const local = copy.courses[course.id];
const anmelden = `${locPath(locale, "/so-gehts")}${ANMELDUNG_HASH}`;
---

<BaseLayout title={`${local?.title ?? course.data.title} ${locale === "de" ? "–" : "—"} Ulpan Ivrit`}>
  <div class="stack">
    <p><a href={locPath(locale, "/kurse")}>{copy.kurse.back}</a></p>
    <h1>{local?.title ?? course.data.title}</h1>
    <p class="muted">{local?.level ?? course.data.level}</p>
    {local ? <div class="stack" set:html={local.body} /> : null}
    <p>
      <a href={LINKS.moodle} {...EXT}>{copy.kurse.moodle}</a>
      <span class="muted">{copy.kurse.moodleNote}</span>
    </p>
    <p>
      <a class="btn" href={anmelden}>{copy.kurse.interestCta}</a>
    </p>
  </div>
</BaseLayout>
