---
import BaseLayout from "../layouts/BaseLayout.astro";
import PrivacyCheck from "../components/PrivacyCheck.astro";
import { ANMELDUNG_HASH } from "../lib/course";
import { LINKS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
const anmelden = `${href("/so-gehts")}${ANMELDUNG_HASH}`;
const subject = encodeURIComponent(copy.vorOrt.subject);
---

<BaseLayout title={copy.vorOrt.title} description={copy.vorOrt.desc}>
  <div class="stack">
    <h1>{copy.vorOrt.h1}</h1>

    <section class="next-course" aria-label={copy.vorOrt.currentTitle}>
      <h2>{copy.vorOrt.currentTitle}</h2>
      <p>{copy.vorOrt.currentMeta}</p>
      <p class="home-price" set:html={copy.vorOrt.currentPrice} />
      <p><a class="btn" href={anmelden}>{copy.vorOrt.currentCta}</a></p>
    </section>

    <p>{copy.vorOrt.p1}</p>

    <div class="card-list">
      <article class="card card-local">
        <h2>{copy.home.localTitle}</h2>
        <p>{copy.vorOrt.p2}</p>
      </article>
      <article class="card">
        <h2>{copy.lehrer.hishtalmut}</h2>
        <p>
          {copy.vorOrt.p3}
          {" "}
          <a href={href("/lehrer")}>{copy.vorOrt.p3Link}</a>.
        </p>
      </article>
    </div>

    <p>
      {copy.vorOrt.p4}
      {" "}
      <a href={anmelden}>{copy.vorOrt.p4Link}</a>.
    </p>

    <h2>{copy.vorOrt.formTitle}</h2>
    <p class="muted">
      {copy.vorOrt.formMail}
      {" "}
      <a href={`mailto:${LINKS.contactEmail}`}>{LINKS.contactEmail}</a>.
    </p>

    <form
      class="stack path-form"
      method="post"
      enctype="text/plain"
      action={`mailto:${LINKS.contactEmail}?subject=${subject}`}
      data-inquiry="host"
      data-sent={copy.form.sent}
      data-error={copy.form.error}
      data-sending={copy.form.sending}
    >
      <input type="hidden" name="locale" value={locale} />
      <div class="hp" aria-hidden="true">
        <label>
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <label>
        {copy.vorOrt.orgType}
        <select name="Organisationstyp" autocomplete="organization-title" required>
          <option value={copy.vorOrt.gemeinde}>{copy.vorOrt.gemeinde}</option>
          <option value={copy.vorOrt.verein}>{copy.vorOrt.verein}</option>
          <option value={copy.vorOrt.community}>{copy.vorOrt.community}</option>
          <option value={copy.vorOrt.other}>{copy.vorOrt.other}</option>
        </select>
      </label>
      <label>
        {copy.vorOrt.orgName}
        <input type="text" name="Organisation" autocomplete="organization" required />
      </label>
      <label>
        {copy.vorOrt.place}
        <input type="text" name="Ort" autocomplete="address-level2" required />
      </label>
      <label>
        {copy.vorOrt.person}
        <input type="text" name="Name" autocomplete="name" required />
      </label>
      <label>
        {copy.vorOrt.email}
        <input type="email" name="E-Mail" autocomplete="email" spellcheck="false" required />
      </label>
      <label>
        {copy.vorOrt.phone}
        <input type="tel" name="Telefon" autocomplete="tel" />
      </label>
      <label>
        {copy.vorOrt.size}
        <input type="text" name="Gruppengröße" />
      </label>
      <label>
        {copy.vorOrt.message}
        <textarea name="Nachricht" autocomplete="off" required></textarea>
      </label>
      <PrivacyCheck />
      <button type="submit">{copy.vorOrt.submit}</button>
      <p class="form-status" data-form-status hidden></p>
    </form>
  </div>
</BaseLayout>
