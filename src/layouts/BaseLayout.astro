---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locPath, stripLocalePrefix, uiLocales, htmlLang, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";
import { LINKS } from "../lib/links";

interface Props {
  title: string;
  description?: string;
  full?: boolean;
}

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const {
  title,
  description = copy.meta.descDefault,
  full = false,
} = Astro.props;

const path = stripLocalePrefix(Astro.url.pathname);
const origin = Astro.site?.origin ?? LINKS.site;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {
      uiLocales.map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={new URL(locPath(code, path), origin).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(locPath("de", path), origin).href}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@700&family=Montserrat:wght@200;300;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class:list={[full ? "full-main" : "wrap page-main"]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
