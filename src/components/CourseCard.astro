---
interface Props {
  status: string;
  level: string;
  place: string;
  venue?: string;
  schedule: string;
  start: string;
  format: string;
  detailsHref: string;
  detailsLabel: string;
  ctaHref: string;
  ctaLabel: string;
  open?: boolean;
}

const {
  status,
  level,
  place,
  venue,
  schedule,
  start,
  format,
  detailsHref,
  detailsLabel,
  ctaHref,
  ctaLabel,
  open = false,
} = Astro.props;
---

<details class="course-chip" open={open || undefined}>
  <summary class="course-chip-summary">
    <span class="course-chip-place">{place}</span>
    <span class="course-chip-level">{level}</span>
    <span class="course-chip-status">{status}</span>
  </summary>
  <div class="course-chip-body">
    {venue && <p class="course-chip-venue">{venue}</p>}
    <dl class="course-chip-meta">
      <div>
        <dt class="visually-hidden">Start</dt>
        <dd>{start}</dd>
      </div>
      <div>
        <dt class="visually-hidden">Schedule</dt>
        <dd>{schedule}</dd>
      </div>
      <div>
        <dt class="visually-hidden">Format</dt>
        <dd>{format}</dd>
      </div>
    </dl>
    <p class="course-chip-actions">
      <a class="course-card-cta" href={ctaHref}>{ctaLabel}</a>
      <a class="course-card-link" href={detailsHref}>{detailsLabel}</a>
    </p>
  </div>
</details>
