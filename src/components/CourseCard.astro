---
interface Props {
  status: string;
  level: string;
  place: string;
  venue?: string;
  schedule: string;
  start: string;
  format: string;
  detailsHref: string;
  detailsLabel: string;
  ctaHref: string;
  ctaLabel: string;
  open?: boolean;
  panelId: string;
}

const {
  status,
  level,
  place,
  venue,
  schedule,
  start,
  format,
  detailsHref,
  detailsLabel,
  ctaHref,
  ctaLabel,
  open = false,
  panelId,
} = Astro.props;
---

<div class="course-chip" data-course-chip>
  <button
    type="button"
    class="course-chip-summary"
    aria-expanded={open ? "true" : "false"}
    aria-controls={panelId}
    id={`${panelId}-trigger`}
  >
    <span class="course-chip-main">
      <span class="course-chip-place">{place}</span>
      <span class="course-chip-level">{level}</span>
    </span>
    <span class="course-chip-meta-inline">
      <span class="course-chip-status">{status}</span>
      <span class="course-chip-start">{start}</span>
    </span>
    <span class="course-chip-toggle" aria-hidden="true"></span>
  </button>
  <div
    class="course-chip-body"
    id={panelId}
    role="region"
    aria-labelledby={`${panelId}-trigger`}
    hidden={!open}
  >
    {venue && <p class="course-chip-venue">{venue}</p>}
    <dl class="course-chip-meta">
      <div>
        <dt class="visually-hidden">Schedule</dt>
        <dd>{schedule}</dd>
      </div>
      <div>
        <dt class="visually-hidden">Format</dt>
        <dd>{format}</dd>
      </div>
    </dl>
    <p class="course-chip-actions">
      <a class="course-card-cta" href={ctaHref}>{ctaLabel}</a>
      <a class="course-card-link" href={detailsHref}>{detailsLabel}</a>
    </p>
  </div>
</div>
