---
interface Props {
  compact?: boolean;
  priority?: boolean;
}

const { compact = false, priority = false } = Astro.props;
---

<img
  class:list={["logo", { compact }]}
  src="/brand/logo.png"
  alt="Ulpan Ivrit"
  width="568"
  height="248"
  fetchpriority={priority ? "high" : "auto"}
  loading={priority ? "eager" : "lazy"}
  decoding="async"
/>

<style>
  .logo {
    display: block;
    width: auto;
    height: 96px;
  }
  .compact {
    height: 40px;
  }
</style>
