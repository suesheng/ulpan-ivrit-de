---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<img
  class:list={["logo", { compact }]}
  src="/brand/logo.png"
  alt="ulpan ivrit"
  width="568"
  height="248"
/>

<style>
  .logo {
    display: block;
    width: auto;
    height: 96px;
  }
  .compact {
    height: 40px;
  }
</style>
