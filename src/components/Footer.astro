---
import { EXT, LINKS, PARTNERS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <nav class="footer-cols" aria-label={copy.meta.footerAria}>
      <div>
        <p>{copy.nav.lernen}</p>
        <a href={href("/so-gehts") + "#anmeldung"}>{copy.nav.anmelden}</a>
        <a href={href("/vor-ort")}>{copy.nav.vorOrt}</a>
        <a href={href("/kurse")}>{copy.nav.onlineSoon}</a>
      </div>
      <div>
        <p>{copy.nav.lehrkraefte}</p>
        <a href={href("/lehrer")}>{copy.nav.methodik}</a>
        <a href={href("/stellen")}>{copy.nav.stellen}</a>
      </div>
      <div>
        <p>{copy.nav.verein}</p>
        <a href={href("/verein")}>{copy.nav.aboutVerein}</a>
        <a href={href("/partner")}>{copy.nav.partner}</a>
        <a href={href("/kontakt")}>{copy.nav.kontakt}</a>
      </div>
    </nav>
    <nav class="legal-links" aria-label={copy.meta.legalAria}>
      <a href={href("/impressum")}>{copy.legal.impressum}</a>
      <a href={href("/datenschutz")}>{copy.legal.datenschutz}</a>
      <a href={href("/cookies")}>{copy.legal.noCookies}</a>
      <a href={LINKS.moodle} {...EXT}>Moodle</a>
    </nav>
  </div>
  <nav class="partner-strip" aria-label={copy.meta.partnersAria}>
    <div class="wrap partner-bar">
      {
        PARTNERS.map((partner) => (
          <a
            href={partner.href}
            {...EXT}
            aria-label={copy.partner.names[partner.id] ?? partner.name}
            data-partner={partner.id}
          >
            <img
              src={partner.logo}
              alt=""
              width={partner.width}
              height={partner.height}
            />
          </a>
        ))
      }
    </div>
  </nav>
</footer>
