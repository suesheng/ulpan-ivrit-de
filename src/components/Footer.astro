---
import { EXT, LINKS, PARTNERS } from "../lib/links";
import { locPath, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const href = (p: string) => locPath(locale, p);

const groups = [
  {
    label: copy.nav.lernen,
    links: [
      { href: href("/so-gehts") + "#anmeldung", label: copy.nav.anmelden },
      { href: href("/preise"), label: copy.nav.preise },
      { href: href("/vor-ort"), label: copy.nav.vorOrt },
      { href: href("/kurse"), label: copy.nav.onlineSoon },
    ],
  },
  {
    label: copy.nav.lehrkraefte,
    links: [
      { href: href("/lehrer"), label: copy.nav.methodik },
      { href: href("/stellen"), label: copy.nav.stellen },
    ],
  },
  {
    label: copy.nav.verein,
    links: [
      { href: href("/verein"), label: copy.nav.aboutVerein },
      { href: href("/partner"), label: copy.nav.partner },
      { href: href("/kontakt"), label: copy.nav.kontakt },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <nav class="footer-cols footer-cols-desktop" aria-label={copy.meta.footerAria}>
      {
        groups.map((group) => (
          <div>
            <p>{group.label}</p>
            {group.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        ))
      }
    </nav>
    <nav class="footer-accordion" aria-label={copy.meta.footerAria}>
      {
        groups.map((group) => (
          <details class="footer-group">
            <summary>{group.label}</summary>
            <div class="footer-group-links">
              {group.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </details>
        ))
      }
    </nav>
    <nav class="legal-links" aria-label={copy.meta.legalAria}>
      <a href={href("/impressum")}>{copy.legal.impressum}</a>
      <a href={href("/datenschutz")}>{copy.legal.datenschutz}</a>
      <a href={href("/teilnahmebedingungen")}>{copy.legal.teilnahmebedingungen}</a>
      <a href={href("/widerruf")}>{copy.legal.widerruf}</a>
      <a href={href("/cookies")}>{copy.legal.noCookies}</a>
      <a href={LINKS.moodle} {...EXT}>Moodle</a>
    </nav>
  </div>
  <nav class="partner-strip" aria-label={copy.meta.partnersAria}>
    <div class="wrap partner-bar">
      {
        PARTNERS.map((partner) => (
          <a
            href={partner.href}
            {...EXT}
            aria-label={copy.partner.names[partner.id] ?? partner.name}
            data-partner={partner.id}
          >
            <img
              src={partner.logo}
              alt=""
              width={partner.width}
              height={partner.height}
            />
          </a>
        ))
      }
    </div>
  </nav>
</footer>
