---
import { EXT, LINKS } from "../lib/links";
import { pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";

interface Props {
  label?: string;
}

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const { label = t(locale).nav.member } = Astro.props;
---

<a class="btn" href={LINKS.membership} {...EXT}>{label}</a>
