---
import { locPath, pageLocale } from "../lib/i18n";
import { ANMELDUNG_HASH } from "../lib/course";
import { t } from "../lib/messages";

interface Props {
  label?: string;
}

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const { label = t(locale).nav.member } = Astro.props;
const href = locPath(locale, "/so-gehts") + ANMELDUNG_HASH;
---

<a class="btn" href={href}>{label}</a>
