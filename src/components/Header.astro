---
import { ANMELDUNG_HASH } from "../lib/course";
import { locPath, stripLocalePrefix, uiLocales, uiLocale, pageLocale } from "../lib/i18n";
import { t } from "../lib/messages";
import Logo from "./Logo.astro";

const locale = pageLocale(Astro.currentLocale, Astro.url.pathname);
const copy = t(locale);
const path = stripLocalePrefix(Astro.url.pathname);
const href = (p: string) => locPath(locale, p);
const anmelden = href("/so-gehts") + ANMELDUNG_HASH;

const groups = [
  {
    id: "lernen",
    label: copy.nav.lernen,
    items: [
      { href: anmelden, path: "/so-gehts", label: copy.nav.anmelden },
      { href: href("/preise"), path: "/preise", label: copy.nav.preise },
      { href: href("/vor-ort"), path: "/vor-ort", label: copy.nav.vorOrt },
      { href: href("/kurse"), path: "/kurse", label: copy.nav.onlineSoon },
    ],
  },
  {
    id: "lehrkraefte",
    label: copy.nav.lehrkraefte,
    items: [
      { href: href("/lehrer"), path: "/lehrer", label: copy.nav.methodik },
      { href: href("/stellen"), path: "/stellen", label: copy.nav.stellen },
    ],
  },
  {
    id: "verein",
    label: copy.nav.verein,
    items: [
      { href: href("/verein"), path: "/verein", label: copy.nav.aboutVerein },
      { href: href("/partner"), path: "/partner", label: copy.nav.partner },
      { href: href("/faq"), path: "/faq", label: copy.nav.faq },
      { href: href("/kontakt"), path: "/kontakt", label: copy.nav.kontakt },
    ],
  },
];
---

<header class="site-header">
  <div class="wrap nav" data-nav>
    <a class="brand" href={href("/")} aria-label="Ulpan Ivrit" translate="no">
      <Logo compact priority />
    </a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={copy.nav.menu}
      data-nav-toggle
    >
      <span class="nav-toggle-icon" aria-hidden="true"></span>
      <span class="nav-toggle-label">{copy.nav.menu}</span>
    </button>
    <nav class="nav-links" id="site-nav" aria-label={copy.meta.navAria} data-nav-panel>
      {
        groups.map((group) => {
          const current = group.items.some(
            (item) => path === item.path || path.startsWith(`${item.path}/`),
          );
          return (
            <details class="nav-group">
              <summary class:list={[{ current }]}>
                {group.label}
              </summary>
              <ul class="nav-panel">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      data-nav-link
                      aria-current={path === item.path || path.startsWith(`${item.path}/`) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          );
        })
      }
      <div class="nav-mobile-extra">
        <nav class="lang-switch lang-switch-mobile" aria-label={copy.meta.langAria}>
          {
            uiLocales.map((code) => (
              <a
                href={locPath(code, path)}
                hreflang={code}
                lang={code}
                data-nav-link
                aria-current={uiLocale(locale) === code ? "page" : undefined}
              >
                {code.toUpperCase()}
              </a>
            ))
          }
        </nav>
        <a class="btn nav-cta-mobile" href={anmelden} data-nav-link>{copy.home.registerNow}</a>
      </div>
    </nav>
    <nav class="lang-switch lang-switch-bar" aria-label={copy.meta.langAria}>
      {
        uiLocales.map((code) => (
          <a
            href={locPath(code, path)}
            hreflang={code}
            lang={code}
            aria-current={uiLocale(locale) === code ? "page" : undefined}
          >
            {code.toUpperCase()}
          </a>
        ))
      }
    </nav>
    <a class="btn nav-cta" href={anmelden}>{copy.home.registerNow}</a>
  </div>
</header>

<a class="mobile-sticky-cta" href={anmelden} data-sticky-cta hidden>
  {copy.home.registerNow}
</a>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const groups = document.querySelectorAll<HTMLDetailsElement>(".nav-group");
  const stickyCta = document.querySelector<HTMLAnchorElement>("[data-sticky-cta]");
  const hero = document.querySelector<HTMLElement>(".hero");
  const footer = document.querySelector<HTMLElement>(".site-footer");

  function setMenuOpen(open: boolean) {
    nav?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("is-nav-open", open);
  }

  function closeMenu() {
    setMenuOpen(false);
  }

  toggle?.addEventListener("click", () => {
    const open = !(nav?.classList.contains("is-open") ?? false);
    setMenuOpen(open);
  });

  groups.forEach((group) => {
    group.addEventListener("toggle", () => {
      if (!group.open) return;
      groups.forEach((other) => {
        if (other !== group) other.open = false;
      });
    });
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    groups.forEach((group) => {
      if (!group.contains(target)) group.open = false;
    });
    if (nav && !nav.contains(target)) closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    groups.forEach((group) => {
      group.open = false;
    });
    closeMenu();
  });

  nav?.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  function updateStickyCta() {
    if (!stickyCta || !hero) return;
    if (window.matchMedia("(min-width: 881px)").matches) {
      stickyCta.hidden = true;
      return;
    }
    const pastHero = window.scrollY > hero.offsetTop + hero.offsetHeight * 0.7;
    let nearFooter = false;
    if (footer) {
      const footerTop = footer.getBoundingClientRect().top;
      nearFooter = footerTop < window.innerHeight - 24;
    }
    stickyCta.hidden = !(pastHero && !nearFooter);
  }

  window.addEventListener("scroll", updateStickyCta, { passive: true });
  window.addEventListener("resize", updateStickyCta);
  updateStickyCta();
</script>
