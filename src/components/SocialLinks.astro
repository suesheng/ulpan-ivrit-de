---

<nav class="footer-social" aria-label={label}>
  {
    SOCIAL.map((item) =>
      item.href ? (
        <a
          class={`footer-social-link footer-social-${item.id}`}
          href={item.href}
          {...EXT}
          aria-label={item.label}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path d={paths[item.id]} />
          </svg>
        </a>
      ) : (
        <span
          class={`footer-social-link is-pending footer-social-${item.id}`}
          aria-label={`${item.label} (bald)`}
          title={`${item.label} — bald`}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path d={paths[item.id]} />
          </svg>
        </span>
      ),
    )
  }
</nav>
